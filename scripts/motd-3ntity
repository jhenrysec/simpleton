#!/bin/bash
# Color login banner. Print it from /etc/profile.d, or run it directly.
# Skips scp and scripts. Needs a UTF-8 terminal.
stop() { return 0 2>/dev/null || exit 0; }
[ -t 1 ] || stop
case $- in *i*) ;; *) stop ;; esac

if command -v locale >/dev/null 2>&1; then
  loc=$(locale -a 2>/dev/null | awk 'BEGIN{IGNORECASE=1} /utf-?8/ { print; exit }')
  if [ -n "$loc" ]; then
    export LANG=$loc LC_ALL=$loc
  fi
fi

if command -v tput >/dev/null 2>&1; then
  cols=$(tput cols 2>/dev/null || echo 80)
else
  cols=${COLUMNS:-80}
fi
case $cols in ''|*[!0-9]*) cols=80 ;; esac
[ "$cols" -lt 60 ] && cols=60

paint() {
  local code=$1 line pad block max=0
  local -a lines=()
  while IFS= read -r line || [ -n "$line" ]; do
    lines+=("$line")
    [ "${#line}" -gt "$max" ] && max=${#line}
  done
  pad=$(( (cols - max) / 2 ))
  [ "$pad" -lt 0 ] && pad=0
  for line in "${lines[@]}"; do
    [ -z "$line" ] && continue
    printf '%*s\033[1;38;5;%sm%s\033[0m\n' "$pad" "" "$code" "$line"
  done
}

printf '\n'
paint 51 << 'EOF'
        ________________
     .-'              `-.
   .'                    `.
  /     ____      ____     \
 |     /    \    /    \     |
 |    | .--. |  | .--. |    |
 |     \ __ /    \ __ /     |
  \                        /
   `.       ______       .'
     `-.____|    |____.-'
          `'`'`'`'`'`
EOF

paint 201 << 'EOF'
██████╗ ███╗   ██╗████████╗██╗████████╗██╗   ██╗
╚════██╗████╗  ██║╚══██╔══╝██║╚══██╔══╝╚██╗ ██╔╝
 █████╔╝██╔██╗ ██║   ██║   ██║   ██║    ╚████╔╝
EOF
paint 46 << 'EOF'
██╔═══╝ ██║╚██╗██║   ██║   ██║   ██║     ╚██╔╝
███████╗██║ ╚████║   ██║   ██║   ██║      ██║
╚══════╝╚═╝  ╚═══╝   ╚═╝   ╚═╝   ╚═╝      ╚═╝
EOF

printf '\n'
bar="  HACKED BY 3NTITY  "
pad=$(( (cols - ${#bar}) / 2 ))
[ "$pad" -lt 0 ] && pad=0
printf '%*s\033[1;97;48;5;196m%s\033[0m\n' "$pad" "" "$bar"
line="session recorded   ·   privileges elevated   ·   welcome back"
pad=$(( (cols - ${#line}) / 2 ))
[ "$pad" -lt 0 ] && pad=0
printf '\n%*s\033[38;5;220m%s\033[0m\n\n' "$pad" "" "$line"
