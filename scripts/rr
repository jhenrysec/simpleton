rr_cols() {
    cols=80
    rows=24
    if [ -n "${COLUMNS:-}" ]; then cols=$COLUMNS; fi
    if [ -n "${LINES:-}" ]; then rows=$LINES; fi
    if command -v tput >/dev/null 2>&1; then
        cols=$(tput cols 2>/dev/null || printf '%s' "$cols")
        rows=$(tput lines 2>/dev/null || printf '%s' "$rows")
    fi
    case $cols in ''|*[!0-9]*) cols=80 ;; esac
    case $rows in ''|*[!0-9]*) rows=24 ;; esac
    [ "$cols" -lt 40 ] && cols=40
    [ "$rows" -lt 12 ] && rows=12
    RR_COLS=$cols
    RR_ROWS=$rows
}

rr_locale() {
    loc=""
    if command -v locale >/dev/null 2>&1; then
        loc=$(locale -a 2>/dev/null | awk 'BEGIN{IGNORECASE=1} /utf-?8/ {print; exit}')
    fi
    if [ -z "$loc" ]; then
        for cand in C.UTF-8 C.utf8 en_US.UTF-8 en_US.utf8; do
            if [ -e "/usr/lib/locale/$cand" ] || [ -e "/usr/lib/locale/${cand}.utf8" ]; then
                loc=$cand
                break
            fi
        done
    fi
    if [ -n "$loc" ]; then
        export LANG=$loc LC_ALL=$loc
    fi
}

rr_show() {
    panel=$1
    maxr=$2
    cols=$3
    printf '%s\n' "$panel" | awk -v cols="$cols" -v maxr="$maxr" '
        NR > maxr { exit }
        {
            n = length($0)
            start = 0
            if (n > cols) start = int((n - cols) / 2)
            print substr($0, start + 1, cols)
        }
    '
}

rickroll() {
    if [ ! -t 1 ]; then
        return 0
    fi
    rr_locale
    rr_cols
    ttyname=$(tty 2>/dev/null || printf '%s' "notty")
    lock="/tmp/rr.${USER:-user}.${ttyname//\//_}"
    if [ -e "$lock" ]; then
        return 0
    fi
    printf '%s\n' "$$" > "$lock" 2>/dev/null || return 0

    old_stty=$(stty -g 2>/dev/null || true)
    trap '' INT QUIT TSTP
    stty -echo -icanon -ixon min 0 time 0 2>/dev/null || true
    printf '\033[?25l'
    (
        while true; do
            IFS= read -rs -n 1 _ || sleep 0.05
        done
    ) &
    drain=$!

    lyrics=(
        "We're no strangers to love"
        "You know the rules and so do I"
        "A full commitment's what I'm thinking of"
        "You wouldn't get this from any other guy"
        "I just wanna tell you how I'm feeling"
        "Gotta make you understand"
        "Never gonna give you up"
        "Never gonna let you down"
        "Never gonna run around and desert you"
        "Never gonna make you cry"
        "Never gonna say goodbye"
        "Never gonna tell a lie and hurt you"
    )
    idx=0
    lyric_idx=0
    art_rows=$((RR_ROWS - 4))
    [ "$art_rows" -lt 8 ] && art_rows=8
    deadline=$((SECONDS + 35))

    while [ "$SECONDS" -lt "$deadline" ]; do
        printf '\033[H\033[2J'
        if [ "$RR_COLS" -ge 78 ]; then
            printf '\033[1;31m%s\033[0m\n' "Never gonna give you up"
        fi
        rr_show "${panels[$idx]}" "$art_rows" "$RR_COLS"
        printf '\n\033[1;36m%s\033[0m\n' "${lyrics[$lyric_idx]}"
        idx=$(( (idx + 1) % ${#panels[@]} ))
        lyric_idx=$(( (lyric_idx + 1) % ${#lyrics[@]} ))
        sleep 0.45
    done

    kill "$drain" 2>/dev/null || true
    wait "$drain" 2>/dev/null || true
    [ -n "$old_stty" ] && stty "$old_stty" 2>/dev/null || stty sane 2>/dev/null || true
    printf '\033[?25h\033[0m\n'
    rm -f "$lock"
}

rickroll
